        stage('Get Pods in Springapp namespace'){
            steps{
              withCredentials([aws(accessKeyVariable: 'AWS_ACCESS_KEY_ID', credentialsId: 'aws_cred', secretKeyVariable: 'AWS_SECRET_ACCESS_KEY')]) {
                sh "echo 'Get Pods in springapp namespace'"
                sh "kubectl get po -n springapp"
                }
            }
        }
        stage('Get Services in Springapp Namespace'){
            steps{
              withCredentials([aws(accessKeyVariable: 'AWS_ACCESS_KEY_ID', credentialsId: 'aws_cred', secretKeyVariable: 'AWS_SECRET_ACCESS_KEY')]) {
                sh "echo 'Get Services in springapp Namespace'"
                sh "kubectl get svc -n springapp"
                }
            }
        } 
    }
} 
